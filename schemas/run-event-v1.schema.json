{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars.local/schemas/run-event-v1.schema.json",
  "title": "ARS run event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "event_type", "elapsed_seconds", "recorded_at", "payload"],
  "properties": {
    "schema_version": {"const": "ars.run-event.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {
      "enum": [
        "run.started",
        "model_call.started",
        "model_call.completed",
        "candidate.submitted",
        "evaluation.completed",
        "resource.updated",
        "run.stopped"
      ]
    },
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "recorded_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "run.started"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/runStarted"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "model_call.started"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/modelCallStarted"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "model_call.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/modelCallCompleted"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "candidate.submitted"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/candidateSubmitted"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "evaluation.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/evaluationCompleted"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "resource.updated"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/resourceUpdated"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "run.stopped"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/runStopped"}}}
    }
  ],
  "$defs": {
    "closed": {"type": "object", "additionalProperties": false},
    "runStarted": {
      "type": "object", "additionalProperties": false,
      "required": ["problem_id", "suite_id", "track", "system_manifest_sha256"],
      "properties": {
        "problem_id": {"type": "string"}, "suite_id": {"type": "string"},
        "track": {"enum": ["controlled-model", "single-model", "unlimited"]},
        "system_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelCallStarted": {
      "type": "object", "additionalProperties": false, "required": ["call_id", "model"],
      "properties": {"call_id": {"type": "string"}, "model": {"type": "string"}}
    },
    "modelCallCompleted": {
      "type": "object", "additionalProperties": false,
      "required": ["call_id", "status", "input_tokens", "output_tokens", "cached_tokens", "cost_usd"],
      "properties": {
        "call_id": {"type": "string"}, "status": {"enum": ["completed", "failed", "cancelled"]},
        "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "candidateSubmitted": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "source_sha256", "language"],
      "properties": {
        "candidate_id": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"},
        "language": {"type": "string"}
      }
    },
    "evaluationCompleted": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_id", "candidate_id", "visibility", "judge_result", "score", "wall_seconds", "cpu_seconds"],
      "properties": {
        "evaluation_id": {"type": "string"}, "candidate_id": {"type": "string"},
        "visibility": {"enum": ["public", "private-post-run"]}, "judge_result": {"type": "string"},
        "score": {"type": ["integer", "null"]}, "wall_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0}
      }
    },
    "resourceUpdated": {
      "type": "object", "additionalProperties": false,
      "required": ["model_calls", "input_tokens", "output_tokens", "cached_tokens", "cost_usd", "evaluator_cpu_seconds"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}, "cached_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}, "evaluator_cpu_seconds": {"type": "number", "minimum": 0}
      }
    },
    "runStopped": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {"reason": {"enum": ["completed", "deadline", "failed", "cancelled"]}}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
